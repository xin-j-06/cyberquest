generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}
enum AccountStatus {
  ACTIVE
  FROZEN
  DISABLED
  PENDING_DELETION
}
enum ReviewStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}
enum Category {
  WEB
  CRYPTO
  REVERSE
  PWN
  FORENSICS
  NETWORK
  MISC
}
enum LabStatus {
  STOPPED
  STARTING
  RUNNING
  EXPIRED
  FAILED
}
enum SkillStatus {
  LOCKED
  AVAILABLE
  LEARNING
  MASTERED
}

model User {
  id String @id @default(cuid())
  username String @unique
  email String @unique
  passwordHash String
  avatar String?
  role Role @default(USER)
  status AccountStatus @default(ACTIVE)
  sessionVersion Int @default(0)
  mustChangePassword Boolean @default(false)
  mfaEnabled Boolean @default(false)
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  deletedAt DateTime?
  deletionScheduledAt DateTime?
  lastLoginIp String?
  score Int @default(0)
  xp Int @default(0)
  level Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?
  lastActiveAt DateTime?
  solves ChallengeSolve[]
  attempts ChallengeAttempt[]
  skills UserSkill[]
  unlockedHints UserHint[]
  labs LabInstance[]
  activities Activity[]
  notifications Notification[]
  sessions Session[]
  courseProgress CourseProgress[]
  achievements UserAchievement[]
  challengeNotes ChallengeNote[]
  announcements Announcement[]
  competitions Competition[]
  managedTools TrainingTool[]
  calendarMemos CalendarMemo[]
  feedbacks Feedback[]
  forumPosts ForumPost[] @relation("ForumPostAuthor")
  forumReplies ForumReply[] @relation("ForumReplyAuthor")
  aiConversations AiConversation[]
  aiMemory AiMemory?
  @@index([role])
  @@index([status,deletedAt])
  @@index([score])
}
model AiConversation {
  id String @id @default(cuid())
  userId String
  title String
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  messages AiMessage[]
  @@index([userId,archived,updatedAt])
}
model AiMessage {
  id String @id @default(cuid())
  conversationId String
  role String
  content String
  provider String?
  feedback String?
  createdAt DateTime @default(now())
  conversation AiConversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  @@index([conversationId,createdAt])
}
model AiMemory {
  userId String @id
  snapshot Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model Announcement {
  id String @id @default(cuid())
  title String
  content String
  published Boolean @default(true)
  reviewStatus ReviewStatus @default(DRAFT)
  priority String @default("NORMAL")
  scheduledAt DateTime?
  expiresAt DateTime?
  audience String @default("ALL")
  revision Int @default(1)
  deletedAt DateTime?
  authorId String?
  author User? @relation(fields:[authorId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published,createdAt])
  @@index([authorId])
  @@index([deletedAt])
}
model Competition {
  id String @id @default(cuid())
  title String
  category String
  operator String
  status String
  scope String
  description String
  tags Json
  url String
  startAt DateTime?
  endAt DateTime?
  registrationDeadline DateTime?
  published Boolean @default(false)
  featured Boolean @default(false)
  reviewStatus ReviewStatus @default(DRAFT)
  timezone String @default("Asia/Shanghai")
  capacity Int?
  format String @default("")
  sourceVerified Boolean @default(false)
  revision Int @default(1)
  deletedAt DateTime?
  authorId String?
  author User? @relation(fields:[authorId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published,startAt])
  @@index([category,published])
  @@index([authorId])
  @@index([deletedAt])
}
model CalendarMemo {
  id String @id @default(cuid())
  userId String
  date String
  title String
  note String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,date])
}
model TrainingTool {
  id String @id @default(cuid())
  name String @unique
  icon String
  category String
  description String
  platforms Json
  source String
  usagePath String @default("")
  officialUrl String @default("")
  actionLabel String @default("查看官网")
  installCommand String?
  published Boolean @default(true)
  recommended Boolean @default(false)
  sortOrder Int @default(0)
  version String @default("")
  checksumSha256 String @default("")
  license String @default("")
  sourceVerified Boolean @default(false)
  deprecated Boolean @default(false)
  reviewStatus ReviewStatus @default(DRAFT)
  revision Int @default(1)
  deletedAt DateTime?
  authorId String?
  author User? @relation(fields:[authorId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published,sortOrder])
  @@index([category,published])
  @@index([authorId])
  @@index([deletedAt])
}
model Feedback {
  id String @id @default(cuid())
  userId String?
  username String
  email String
  type String
  title String
  content String
  pageUrl String?
  status String @default("NEW")
  adminNote String?
  priority String @default("MEDIUM")
  severity String @default("S3")
  assignee String?
  publicReply String?
  tags Json @default("[]")
  slaDueAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  @@index([status,createdAt])
  @@index([userId])
}
model ForumPost {
  id String @id @default(cuid())
  category String
  title String
  content String
  authorId String?
  authorName String
  authorRole String
  pinned Boolean @default(false)
  views Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User? @relation("ForumPostAuthor",fields:[authorId],references:[id],onDelete:SetNull)
  replies ForumReply[]
  @@index([pinned,updatedAt])
  @@index([category,updatedAt])
  @@index([authorId])
}
model ForumReply {
  id String @id @default(cuid())
  postId String
  authorId String?
  authorName String
  authorRole String
  content String
  createdAt DateTime @default(now())
  post ForumPost @relation(fields:[postId],references:[id],onDelete:Cascade)
  author User? @relation("ForumReplyAuthor",fields:[authorId],references:[id],onDelete:SetNull)
  @@index([postId,createdAt])
  @@index([authorId])
}
model Challenge {
  id String @id @default(cuid())
  slug String @unique
  title String
  description String
  goal String @default("")
  tags String[] @default([])
  category Category
  difficulty String
  points Int
  flagHash String
  author String @default("CyberQuest Team")
  isActive Boolean @default(true)
  reviewStatus ReviewStatus @default(DRAFT)
  revision Int @default(1)
  owner String @default("")
  scheduledAt DateTime?
  maxConcurrentLabs Int @default(20)
  cpuLimit Float @default(1)
  memoryLimitMb Int @default(512)
  deletedAt DateTime?
  isDynamic Boolean @default(false)
  labKind String @default("AUTO")
  labTtlMinutes Int @default(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  solves ChallengeSolve[]
  attempts ChallengeAttempt[]
  hints ChallengeHint[]
  skills ChallengeSkill[]
  labs LabInstance[]
  notes ChallengeNote[]
  @@index([category,difficulty])
  @@index([isActive])
  @@index([deletedAt])
}
model ChallengeNote {
  id String @id @default(cuid())
  userId String
  challengeId String
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  challenge Challenge @relation(fields:[challengeId],references:[id],onDelete:Cascade)
  @@index([userId,challengeId])
  @@index([userId,updatedAt])
  @@index([challengeId])
}
model ChallengeSolve {
  id String @id @default(cuid())
  userId String
  challengeId String
  points Int
  solvedAt DateTime @default(now())
  isFirstBlood Boolean @default(false)
  user User @relation(fields:[userId],references:[id])
  challenge Challenge @relation(fields:[challengeId],references:[id])
  @@unique([userId,challengeId])
  @@index([challengeId,solvedAt])
}
model ChallengeAttempt {
  id String @id @default(cuid())
  userId String
  challengeId String
  submittedHash String
  correct Boolean
  createdAt DateTime @default(now())
  ipHash String?
  user User @relation(fields:[userId],references:[id])
  challenge Challenge @relation(fields:[challengeId],references:[id])
  @@index([userId,createdAt])
  @@index([challengeId,createdAt])
}
model ChallengeHint {
  id String @id @default(cuid())
  challengeId String
  title String
  content String
  cost Int @default(0)
  order Int
  challenge Challenge @relation(fields:[challengeId],references:[id])
  users UserHint[]
  @@unique([challengeId,order])
}
model UserHint {
  userId String
  hintId String
  unlockedAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  hint ChallengeHint @relation(fields:[hintId],references:[id])
  @@id([userId,hintId])
}
model Skill {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String
  category String
  parentId String?
  x Float @default(0)
  y Float @default(0)
  users UserSkill[]
  challenges ChallengeSkill[]
}
model UserSkill {
  userId String
  skillId String
  xp Int @default(0)
  level Int @default(0)
  status SkillStatus @default(AVAILABLE)
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id])
  skill Skill @relation(fields:[skillId],references:[id])
  @@id([userId,skillId])
  @@unique([userId,skillId])
}
model ChallengeSkill {
  challengeId String
  skillId String
  xpReward Int
  challenge Challenge @relation(fields:[challengeId],references:[id])
  skill Skill @relation(fields:[skillId],references:[id])
  @@id([challengeId,skillId])
  @@unique([challengeId,skillId])
}
model LabInstance {
  id String @id @default(cuid())
  userId String
  challengeId String
  containerId String?
  status LabStatus @default(STOPPED)
  ip String?
  port Int?
  startedAt DateTime?
  expiresAt DateTime
  stoppedAt DateTime?
  user User @relation(fields:[userId],references:[id])
  challenge Challenge @relation(fields:[challengeId],references:[id])
  @@index([userId,status])
  @@index([expiresAt])
}
model Activity {
  id String @id @default(cuid())
  userId String
  type String
  metadata Json?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  @@index([type,createdAt])
  @@index([userId,createdAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  message String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  @@index([userId,read])
}
model Course {
  id String @id @default(cuid())
  title String
  slug String @unique
  description String
  difficulty String
  duration String
  category String
  challengeSlug String?
  chapters Json?
  isPublished Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  progress CourseProgress[]
  @@index([category])
}
model Session {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,expiresAt])
  @@index([expiresAt])
}
model Achievement {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String
  icon String?
  condition Json
  createdAt DateTime @default(now())
  users UserAchievement[]
}
model UserAchievement {
  userId String
  achievementId String
  unlockedAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  achievement Achievement @relation(fields:[achievementId],references:[id],onDelete:Cascade)
  @@id([userId,achievementId])
  @@index([achievementId,unlockedAt])
}
model CourseProgress {
  userId String
  courseId String
  progress Int @default(0)
  completedAt DateTime?
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  course Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
  @@id([userId,courseId])
  @@index([courseId,progress])
}
