{
  "openapi": "3.1.0",
  "info": {
    "title": "CyberQuest 2.0 API",
    "version": "2.0.0-local",
    "description": "Safety-first CTF learning API. Flags, flag hashes, access tokens, and private lab details are never exposed to unrelated clients."
  },
  "servers": [{ "url": "http://localhost:3000/api", "description": "Local development" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": { "get": { "operationId": "health", "security": [], "responses": { "200": { "description": "Service is healthy" } } } },
    "/auth/login": { "post": { "operationId": "login", "security": [], "requestBody": { "$ref": "#/components/requestBodies/Login" }, "responses": { "200": { "$ref": "#/components/responses/Auth" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/auth/register": { "post": { "operationId": "register", "security": [], "requestBody": { "$ref": "#/components/requestBodies/Register" }, "responses": { "200": { "$ref": "#/components/responses/Auth" }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/auth/logout": { "post": { "operationId": "logout", "responses": { "200": { "description": "Local access state cleared by the client" } } } },
    "/users/me": { "get": { "operationId": "currentUser", "responses": { "200": { "$ref": "#/components/responses/User" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/users/me/skills": { "get": { "operationId": "userSkills", "responses": { "200": { "$ref": "#/components/responses/SkillProgress" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/admin/users": {
      "get": { "operationId": "adminUsers", "description": "List persisted user accounts without password hashes. Administrator only.", "responses": { "200": { "$ref": "#/components/responses/AdminUsers" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } },
      "post": { "operationId": "createAdminUser", "description": "Create a persisted learner or administrator account.", "requestBody": { "$ref": "#/components/requestBodies/AdminUserCreate" }, "responses": { "201": { "$ref": "#/components/responses/AdminUser" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/admin/users/{userId}": {
      "get": { "operationId": "adminUser", "parameters": [{ "$ref": "#/components/parameters/UserId" }], "responses": { "200": { "$ref": "#/components/responses/AdminUser" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } },
      "patch": { "operationId": "updateAdminUser", "parameters": [{ "$ref": "#/components/parameters/UserId" }], "requestBody": { "$ref": "#/components/requestBodies/AdminUserUpdate" }, "responses": { "200": { "$ref": "#/components/responses/AdminUser" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } },
      "delete": { "operationId": "deleteAdminUser", "parameters": [{ "$ref": "#/components/parameters/UserId" }], "responses": { "200": { "description": "Account and owned records deleted" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/announcements": { "get": { "operationId": "announcements", "security": [], "description": "Published administrator announcements for the learner dashboard.", "responses": { "200": { "$ref": "#/components/responses/Announcements" } } } },
    "/admin/announcements": {
      "get": { "operationId": "adminAnnouncements", "responses": { "200": { "$ref": "#/components/responses/Announcements" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } },
      "post": { "operationId": "createAnnouncement", "requestBody": { "$ref": "#/components/requestBodies/Announcement" }, "responses": { "201": { "$ref": "#/components/responses/Announcement" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/admin/announcements/{id}": {
      "patch": { "operationId": "updateAnnouncement", "parameters": [{ "$ref": "#/components/parameters/AnnouncementId" }], "requestBody": { "$ref": "#/components/requestBodies/Announcement" }, "responses": { "200": { "$ref": "#/components/responses/Announcement" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } },
      "delete": { "operationId": "deleteAnnouncement", "parameters": [{ "$ref": "#/components/parameters/AnnouncementId" }], "responses": { "200": { "description": "Announcement deleted" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/feedback": { "post": { "operationId": "createFeedback", "description": "Submit an authenticated learner bug report or improvement suggestion.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FeedbackInput" } } } }, "responses": { "201": { "description": "Feedback persisted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Feedback" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/admin/feedback": { "get": { "operationId": "adminFeedback", "description": "List all feedback records. Administrator only.", "responses": { "200": { "description": "Feedback inbox", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Feedback" } } } } }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/admin/feedback/{id}": {
      "patch": { "operationId": "updateFeedback", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FeedbackUpdate" } } } }, "responses": { "200": { "description": "Feedback updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Feedback" } } } }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } },
      "delete": { "operationId": "deleteFeedback", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Feedback deleted" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/forum/posts": {
      "get": { "operationId": "forumPosts", "security": [], "responses": { "200": { "description": "Forum topics", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ForumPostSummary" } } } } } } },
      "post": { "operationId": "createForumPost", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ForumPostInput" } } } }, "responses": { "201": { "description": "Forum topic created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ForumPostDetail" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } }
    },
    "/forum/posts/{id}": {
      "get": { "operationId": "forumPost", "security": [], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Forum topic with replies", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ForumPostDetail" } } } }, "404": { "$ref": "#/components/responses/Error" } } },
      "delete": { "operationId": "deleteForumPost", "description": "Delete a topic as its author or an administrator.", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Forum topic deleted" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/forum/posts/{id}/replies": { "post": { "operationId": "createForumReply", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ForumReplyInput" } } } }, "responses": { "201": { "description": "Forum reply created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ForumReply" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/admin/challenges": {
      "get": { "operationId": "adminChallenges", "description": "List active and unpublished CTF challenges with maintenance statistics. Administrator only.", "responses": { "200": { "$ref": "#/components/responses/AdminChallenges" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } },
      "post": { "operationId": "createAdminChallenge", "requestBody": { "$ref": "#/components/requestBodies/AdminChallenge" }, "responses": { "201": { "$ref": "#/components/responses/AdminChallenge" }, "400": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/admin/challenges/{id}": {
      "patch": { "operationId": "updateAdminChallenge", "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }], "requestBody": { "$ref": "#/components/requestBodies/AdminChallenge" }, "responses": { "200": { "$ref": "#/components/responses/AdminChallenge" }, "400": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } },
      "delete": { "operationId": "deleteAdminChallenge", "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }], "description": "Delete only a challenge without learning history; otherwise unpublish it.", "responses": { "200": { "description": "Challenge deleted" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/admin/challenges/{id}/diagnose": { "post": { "operationId": "diagnoseAdminChallenge", "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }], "responses": { "200": { "$ref": "#/components/responses/ChallengeDiagnostic" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/admin/labs": { "get": { "operationId": "adminLabs", "description": "List recent isolated range instances for operations.", "responses": { "200": { "$ref": "#/components/responses/AdminLabs" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/admin/labs/{instanceId}/stop": { "post": { "operationId": "stopAdminLab", "parameters": [{ "$ref": "#/components/parameters/InstanceId" }], "responses": { "200": { "description": "Instance stopped" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/users/me/notes": { "get": { "operationId": "challengeNotes", "responses": { "200": { "$ref": "#/components/responses/ChallengeNotes" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/users/me/notes/{noteId}": { "delete": { "operationId": "deleteChallengeNote", "parameters": [{ "$ref": "#/components/parameters/NoteId" }], "responses": { "200": { "description": "Note deleted" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/challenges": { "get": { "operationId": "listChallenges", "security": [], "responses": { "200": { "$ref": "#/components/responses/Challenges" } } } },
    "/challenges/{id}": { "get": { "operationId": "challengeDetail", "security": [], "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }], "responses": { "200": { "$ref": "#/components/responses/ChallengeDetail" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/challenges/{id}/workspace": { "get": { "operationId": "workspace", "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }], "responses": { "200": { "$ref": "#/components/responses/Workspace" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/challenges/{id}/notes": {
      "get": { "operationId": "challengeNotesForChallenge", "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }], "responses": { "200": { "$ref": "#/components/responses/ChallengeNotes" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } },
      "post": { "operationId": "createChallengeNote", "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }], "requestBody": { "$ref": "#/components/requestBodies/ChallengeNote" }, "responses": { "201": { "$ref": "#/components/responses/ChallengeNote" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/challenges/{id}/attachments/{fileName}": { "get": { "operationId": "downloadChallengeAttachment", "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }, { "$ref": "#/components/parameters/FileName" }], "responses": { "200": { "description": "Allow-listed challenge attachment", "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } } }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/challenges/{id}/submit": { "post": { "operationId": "submitFlag", "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }], "requestBody": { "$ref": "#/components/requestBodies/Flag" }, "responses": { "200": { "$ref": "#/components/responses/Submission" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/challenges/{id}/hints/{hintId}/unlock": { "post": { "operationId": "unlockHint", "description": "Unlock the complete per-challenge official guide for 20 points. Solved challenges can access it without charge.", "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }, { "$ref": "#/components/parameters/HintId" }], "responses": { "200": { "description": "Unlocked official guide content, charged cost, and updated score" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/labs/start": { "post": { "operationId": "startGuidedLab", "requestBody": { "$ref": "#/components/requestBodies/LabStart" }, "responses": { "200": { "$ref": "#/components/responses/LabSession" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/labs/instances/{instanceId}/target": { "get": { "operationId": "labTarget", "parameters": [{ "$ref": "#/components/parameters/InstanceId" }], "responses": { "200": { "$ref": "#/components/responses/LabTarget" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/labs/instances/{instanceId}/interact": { "post": { "operationId": "interactWithLabTarget", "parameters": [{ "$ref": "#/components/parameters/InstanceId" }], "requestBody": { "$ref": "#/components/requestBodies/LabInteraction" }, "responses": { "200": { "$ref": "#/components/responses/LabInteraction" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/labs/{id}/status": { "get": { "operationId": "labStatus", "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }], "responses": { "200": { "$ref": "#/components/responses/LabStatus" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/labs/{id}/refresh": { "post": { "operationId": "refreshGuidedLab", "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }], "responses": { "200": { "$ref": "#/components/responses/LabStatus" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/labs/{id}/stop": { "post": { "operationId": "stopGuidedLab", "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }], "responses": { "200": { "$ref": "#/components/responses/LabStatus" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/range/overview": { "get": { "operationId": "rangeOverview", "security": [], "responses": { "200": { "$ref": "#/components/responses/Range" } } } },
    "/dashboard/stats": { "get": { "operationId": "dashboardStats", "security": [], "responses": { "200": { "$ref": "#/components/responses/DashboardStats" } } } },
    "/dashboard/events": { "get": { "operationId": "dashboardEvents", "security": [], "responses": { "200": { "description": "Recent safe activity summaries" } } } },
    "/leaderboard": { "get": { "operationId": "leaderboard", "security": [], "responses": { "200": { "$ref": "#/components/responses/Leaderboard" } } } },
    "/skills": { "get": { "operationId": "skillGraph", "security": [], "responses": { "200": { "description": "Skill graph" } } } },
    "/learning/overview": { "get": { "operationId": "learningOverview", "security": [], "responses": { "200": { "description": "Courses and optional user progress" } } } },
    "/catalog/sources": { "get": { "operationId": "catalogSources", "security": [], "responses": { "200": { "description": "Approved catalog sources" } } } },
    "/ai/chat": { "post": { "operationId": "askTutor", "requestBody": { "$ref": "#/components/requestBodies/AiChat" }, "responses": { "200": { "$ref": "#/components/responses/Ai" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "parameters": {
      "ChallengeId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 100 } },
      "UserId": { "name": "userId", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 100 } },
      "AnnouncementId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 100 } },
      "NoteId": { "name": "noteId", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 100 } },
      "HintId": { "name": "hintId", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 100 } },
      "FileName": { "name": "fileName", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 100 } },
      "InstanceId": { "name": "instanceId", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 100 } }
    },
    "requestBodies": {
      "Login": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Login" } } } },
      "Register": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Register" } } } },
      "Flag": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FlagSubmission" } } } },
      "ChallengeNote": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChallengeNoteContent" } } } },
      "AdminUserCreate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminUserCreate" } } } },
      "AdminUserUpdate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminUserUpdate" } } } },
      "AdminChallenge": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminChallengeInput" } } } },
      "Announcement": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnnouncementInput" } } } },
      "LabStart": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LabStart" } } } },
      "LabInteraction": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LabInteractionInput" } } } },
      "AiChat": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiChat" } } } }
    },
    "responses": {
      "Auth": { "description": "Authenticated user and short-lived access token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
      "User": { "description": "Current user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
      "AdminUser": { "description": "Administrator-safe persisted account record", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminUser" } } } },
      "AdminUsers": { "description": "Persisted account records", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/AdminUser" } } } } },
      "Announcement": { "description": "Administrator announcement", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Announcement" } } } },
      "Announcements": { "description": "Announcement list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Announcement" } } } } },
      "AdminChallenge": { "description": "Administrator-safe challenge configuration without Flag material", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminChallenge" } } } },
      "AdminChallenges": { "description": "Challenge management records", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/AdminChallenge" } } } } },
      "AdminLabs": { "description": "Recent CTF range instances", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/AdminLab" } } } } },
      "ChallengeDiagnostic": { "description": "Challenge maintenance diagnostic", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChallengeDiagnostic" } } } },
      "Challenges": { "description": "Published challenge summaries", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ChallengeSummary" } } } } },
      "ChallengeDetail": { "description": "Challenge metadata without flag material", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChallengeDetail" } } } },
      "Workspace": { "description": "Private workspace status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } } },
      "Submission": { "description": "Submission result without supplied flag", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Submission" } } } },
      "LabSession": { "description": "Private guided-session state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LabSession" } } } },
      "LabTarget": { "description": "Session-bound CTF scenario and recoverable challenge material; never contains a plaintext flag", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LabTarget" } } } },
      "LabInteraction": { "description": "Synthetic local target response produced by a participant request or payload", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LabInteractionResult" } } } },
      "LabStatus": { "description": "Private guided-session status", "content": { "application/json": { "schema": { "type": "object" } } } },
      "Range": { "description": "Training range overview", "content": { "application/json": { "schema": { "type": "object" } } } },
      "DashboardStats": { "description": "Dashboard aggregate counts", "content": { "application/json": { "schema": { "type": "object" } } } },
