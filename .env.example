NODE_ENV=development
DATA_BACKEND=local
DATABASE_URL=postgresql://cyberquest:cyberquest@postgres:5432/cyberquest
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_LOGIN_EMAIL=admin@cyberquest.local
ATTEMPT_HASH_SECRET=change_me_attempt_hash_secret
LAB_FLAG_SECRET=change_me_lab_flag_secret
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
AI_PROVIDER=deepseek
AI_API_KEY=
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_REQUEST_TIMEOUT_MS=60000
AI_THINKING_ENABLED=true
AI_REASONING_EFFORT=high
AI_MAX_TOKENS=1800
LAB_NETWORK=cyberquest_lab_net
LAB_TTL_SECONDS=1800
SERVER_PORT=3000
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000
